@model List<CampManager.Models.Accommodation>

@{
    ViewData["Title"] = "Smještaj";
}

<h1>Upravljanje smještajem</h1>
<p>CampManager — Miris Ljeta</p>
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
<div class="card mb-4">
    <div class="card-body">
        <h2 class="h4">Dodaj smještaj</h2>

        <div asp-validation-summary="All" class="text-danger"></div>

        <form asp-controller="Accommodations"
              asp-action="Create"
              method="post">

            <div class="mb-3">
                <label for="Name" class="form-label">Naziv</label>
                <input id="Name"
                       name="Name"
                       class="form-control"
                       placeholder="Npr. Bungalov 2"
                       required />
            </div>

            <div class="mb-3">
                <label for="Capacity" class="form-label">
                    Broj osoba
                </label>
                <input id="Capacity"
                       name="Capacity"
                       type="number"
                       min="1"
                       max="50"
                       value="2"
                       class="form-control"
                       required />
            </div>

            <div class="mb-3">
                <label for="PricePerNight" class="form-label">
                    Cijena po noći (KM)
                </label>
                <input id="PricePerNight"
                       name="PricePerNight"
                       type="number"
                       min="1"
                       max="10000"
                       step="1"
                       value="100"
                       class="form-control"
                       required />
            </div>

            <button type="submit" class="btn btn-primary">
                Dodaj smještaj
            </button>
        </form>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Naziv</th>
                <th>Broj osoba</th>
                <th>Cijena po noći</th>
                <th>Akcija</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Capacity</td>
                    <td>@item.PricePerNight.ToString("0.00") KM</td>
                    <td>
                        <div class="d-flex gap-2">
                            <a asp-controller="Accommodations"
                               asp-action="Edit"
                               asp-route-id="@item.Id"
                               class="btn btn-warning btn-sm">
                                Uredi
                            </a>

                            <form asp-controller="Accommodations"
                                  asp-action="Delete"
                                  method="post"
                                  onsubmit="return confirm('Želiš li obrisati ovaj smještaj?');">

                                <input type="hidden"
                                       name="id"
                                       value="@item.Id" />

                                <button type="submit"
                                        class="btn btn-danger btn-sm">
                                    Obriši
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Nema unesenih smještajnih jedinica. Dodaj prvi smještaj kroz formu.
    </div>
}